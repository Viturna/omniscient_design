<%= link_to studio do %>
  <%
    thumb_url = nil
    if studio.studio_images.first&.file&.attached?
      begin
        thumb_url = url_for(studio.studio_images.first.file.variant(:thumb))
      rescue StandardError => e
        thumb_url = nil
      end
    end
  %>
  <% if thumb_url.present? %>
    <div class="card-designer" style="background: url('<%= thumb_url %>'); background-size: cover; background-position: center center;">
  <% else %>
    <div class="card-designer no-image">
  <% end %>
      <div class="inner-card-designer">
        <% if studio.respond_to?(:countries) %>
          <% studio.countries.each do |country| %>
            <p class="country-card-designer">
              <span class="flag"><%= country_flag(country.country_numeric) %></span>
              <%= country.country %>
            </p>
          <% end %>
        <% end %>
        <p class="title-card-designer">
          <%= studio.nom %>
        </p>
      </div>
    </div>
  <% end %>