<style>
  .col-links {
    white-space: normal;
    min-width: 250px;
    max-width: 350px;
  }
  .col-links a {
    color: #007bff;
    word-break: break-all;
  }
  .col-actions {
    white-space: nowrap;
  }
  .badge-gray {
    background: #eee;
    color: #666;
  }
</style>

<div class="users-dash-wrapper">
  <div class="users-dash-header">
    <div style="display: flex; align-items: center; gap: 20px;">
      <%= link_to admin_root_path, class: "users-dash-back-link" do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#202020" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      <% end %>
      <h1 class="users-dash-title"><%= t('admin.etablissements.index.title') %></h1>
    </div>
  </div>

  <div class="users-dash-kpi-grid">
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.etablissements.index.total_etablissements') %></span>
        <div class="kpi-icon bg-blue-light">
          <svg viewBox="0 0 24 24"><path d="M12 2L2 12h3v8h6v-6h2v6h6v-8h3L12 2z"/></svg>
        </div>
      </div>
      <div class="kpi-value"><%= @total_etablissements %></div>
    </div>
    
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.etablissements.index.active_etablissements') %></span>
        <div class="kpi-icon bg-green-light">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-4-4 1.41-1.41L11 14.17l6.59-6.59L19 9l-8 8z"/></svg>
        </div>
      </div>
      <div class="kpi-value"><%= @active_etablissements %></div>
    </div>
    
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.etablissements.index.linked_users') %></span>
        <div class="kpi-icon bg-yellow-light">
          <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        </div>
      </div>
      <div class="kpi-value"><%= @total_users_linked %></div>
    </div>
  </div>

  <div class="users-dash-toolbar">
    <%= form_with url: admin_etablissements_path, method: :get, local: true, class: "users-dash-filter-form" do |f| %>
      <% has_active_filters = params[:query].present? || params[:activity].present? || params[:statut].present? || params[:type_etablissement].present? || params[:academy].present? || params[:section].present? || (params[:sort].present? && params[:sort] != 'users_count_desc') %>

      <!-- Search wrapper matching users index UI -->
      <div class="users-dash-search-wrapper">
        <div class="users-dash-search">
          <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <%= f.text_field :query, value: params[:query], placeholder: "Rechercher par nom, ville, académie, UAI..." %>
        </div>

        <% if has_active_filters %>
          <%= link_to admin_etablissements_path, class: "btn-reset-filters", title: "Réinitialiser tous les filtres" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Effacer les filtres
          <% end %>
        <% end %>

        <%= link_to admin_etablissements_path(format: :csv, query: params[:query], activity: params[:activity], statut: params[:statut], type_etablissement: params[:type_etablissement], academy: params[:academy], section: params[:section], sort: params[:sort]), class: "users-dash-btn-export", style: "background-color: #202020; color: #fff; border: 1px solid #202020;" do %>
          <svg style="margin-right: 6px;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <%= t('admin.etablissements.index.export_csv') %>
        <% end %>
      </div>

      <!-- Bottom Row: Filter Pills -->
      <div class="users-dash-filters-row">
        <!-- Activité / Membres -->
        <div class="filter-pill-item <%= 'active' if params[:activity].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          </div>
          <%= f.select :activity, options_for_select([["Tous les établissements", ""], ["🟢 Avec membres inscrits", "with_users"], ["⚪ Sans membres", "without_users"]], params[:activity]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Statut Public / Privé -->
        <div class="filter-pill-item <%= 'active' if params[:statut].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>
          </div>
          <%= f.select :statut, options_for_select([["Tous les statuts", ""]] + @statuts_for_filter.map { |s| [s.capitalize, s] }, params[:statut]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Type d'établissement -->
        <div class="filter-pill-item filter-pill-large <%= 'active' if params[:type_etablissement].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
          </div>
          <%= f.select :type_etablissement, options_for_select([["Tous les types", ""]] + @types_for_filter.map { |t| [t, t] }, params[:type_etablissement]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Académie -->
        <div class="filter-pill-item <%= 'active' if params[:academy].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          </div>
          <%= f.select :academy, options_for_select([["Toutes les académies", ""]] + @academies_for_filter.map { |a| ["Académie de #{a}", a] }, params[:academy]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Section / Filières -->
        <div class="filter-pill-item <%= 'active' if params[:section].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
          </div>
          <%= f.select :section, options_for_select([
                ["Toutes les filières", ""],
                ["🎨 Section Arts", "arts"],
                ["🎬 Section Cinéma", "cinema"],
                ["🎭 Section Théâtre", "theatre"],
                ["🎓 Post-Bac", "post_bac"],
                ["🛠️ Voie Pro", "pro"],
                ["⚙️ Voie Techno", "techno"]
              ], params[:section]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Tri Select -->
        <div class="filter-pill-item filter-pill-sort <%= 'active' if params[:sort].present? && params[:sort] != 'users_count_desc' %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/></svg>
          </div>
          <%= f.select :sort, options_for_select([
                ["Membres (Plus d'inscrits)", "users_count_desc"],
                ["Membres (Moins d'inscrits)", "users_count_asc"],
                ["Nom (A-Z)", "name_asc"],
                ["Nom (Z-A)", "name_desc"],
                ["Ville (A-Z)", "city_asc"],
                ["Académie (A-Z)", "academy_asc"]
              ], params[:sort] || "users_count_desc"), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="users-dash-table-container">
    <table class="users-dash-table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Utilisateurs</th>
          <th>UAI</th>
          <th>Statut</th>
          <th>Type</th>
          <th>Localisation</th>
          <th>Coordonnées</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @etablissements.each do |etab| %>
          <tr>
            <td>
              <strong><%= etab.name %></strong>
            </td>
            <td>
              <% count = etab.users_count %>
              <span class="badge <%= count > 0 ? 'badge-green' : 'badge-gray' %>">
                <%= count %>
              </span>
            </td>
            <td><code><%= etab.uai %></code></td>
            <td><%= etab.statut_public_prive %></td>
            <td><%= etab.type_etablissement %></td>
            <td>
              <%= etab.city %> (<%= etab.academy %>)<br>
              <small style="color:#666;"><%= etab.region %></small>
            </td>
            <td class="col-links">
              <% if etab.phone.present? %><%= etab.phone %><br><% end %>
              <% if etab.messagerie.present? %><%= mail_to etab.messagerie %><br><% end %>
              <% if etab.website.present? %><%= link_to "Site web", etab.website, target: "_blank" %><% end %>
            </td>
            <td class="col-actions" style="text-align: right; display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
              <%= link_to "Modifier", edit_admin_etablissement_path(etab), class: "badge badge-blue", style: "text-decoration: none;" %>
              <% if count == 0 %>
                <%= link_to "Supprimer", admin_etablissement_path(etab), 
                      class: "badge badge-red", style: "text-decoration: none;",
                      data: { turbo_method: :delete, turbo_confirm: "Supprimer cet établissement ?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div style="margin-top: 24px;">
    <%= paginate @etablissements %>
  </div>
</div>