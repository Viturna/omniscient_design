<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 24px; color: #202020;">
  <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 16px; color: #111;">Nouvelle demande de partenariat école</h2>
  
  <div style="background-color: #f9f9f9; border-radius: 12px; padding: 20px; margin-bottom: 20px; border: 1px solid #eee;">
    <p style="margin: 0 0 10px 0;"><strong>Établissement / École :</strong> <%= @school_name %></p>
    <p style="margin: 0 0 10px 0;"><strong>Email de contact :</strong> <a href="mailto:<%= @email %>" style="color: #2AC769; text-decoration: none;"><%= @email %></a></p>
  </div>

  <div style="margin-bottom: 24px;">
    <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">Message :</h3>
    <div style="background-color: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; white-space: pre-wrap; line-height: 1.5;"><%= @message %></div>
  </div>

  <p style="font-size: 13px; color: #888;">Ce message a été envoyé depuis la landing page schools-ads.omniscientdesign.fr</p>
</div>
