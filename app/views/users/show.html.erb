            <span class="badge badge-gray"><%= @badges.size %> débloqué<%= 's' if @badges.size > 1 %></span>
          <% end %>
        </div>

        <% if @badges.present? && @badges.any? %>
          <div class="gamification-badges-grid">
            <% @badges.each do |badge| %>
              <div class="gamification-badge-item">
                <div class="gamification-badge-icon" title="<%= badge.try(:description) %>">
                  <% if badge.respond_to?(:image) && badge.image.attached? %>
                    <%= image_tag badge.image %>
                  <% elsif badge.respond_to?(:icon_url) && badge.icon_url.present? %>
                    <%= image_tag badge.icon_url %>
                  <% else %>
                    <div class="gamification-badge-placeholder">🏅</div>
                  <% end %>
                </div>
                <div class="gamification-badge-name"><%= badge.name %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div style="padding: 24px 16px; text-align: center; color: #9ca3af; font-size: 13px;">
            <p style="margin: 0;">Aucun badge débloqué pour le moment.</p>
