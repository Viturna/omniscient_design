<div class="badge-card <%= unlocked ? 'unlocked' : 'locked' %> level-<%= badge.level %>">
  <div class="badge-visual">
    <% if !unlocked %>
      <%= image_tag "badges/default.webp", loading: "lazy", class: "badge-img", alt: t('badges.card.locked') %>
    
    <% elsif badge.image_name.present? %>
      <%= image_tag "badges/#{badge.image_name.sub(/\.png$/, '.webp')}", loading: "lazy", class: "badge-img", alt: badge.name %>
    
    <% else %>
      <div class="badge-placeholder"><%= badge.name[0] %></div>
    <% end %>
    
  </div>

  <div class="badge-details">
    <h3 class="badge-title"><%= badge.name %></h3>
    <p class="badge-desc"><%= badge.description %></p>

    <% progress_data = local_assigns[:progress] || (defined?(@gamification_service) && @gamification_service ? @gamification_service.progress_for_badge(badge) : nil) %>
    <% if progress_data.present? %>
      <div class="badge-card-progress">
        <div class="badge-card-progress-track">
          <div class="badge-card-progress-fill" style="width: <%= unlocked ? 100 : progress_data[:percentage] %>%;"></div>
        </div>
        <div class="badge-card-progress-meta">
          <% if unlocked %>
            <span class="badge-progress-status unlocked-status">Débloqué</span>
          <% else %>
            <span class="badge-progress-label"><%= progress_data[:label] %></span>
            <span class="badge-progress-percent"><%= progress_data[:percentage] %>%</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>