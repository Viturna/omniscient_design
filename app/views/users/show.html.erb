<script>
  function setupContribFilters() {
    const filterBtns = document.querySelectorAll(".contrib-filter-btn");
    const rows = document.querySelectorAll(".contrib-row");
    if (!filterBtns.length) return;

    filterBtns.forEach(btn => {
      // Avoid duplicate listener
      btn.replaceWith(btn.cloneNode(true));
    });

    const newFilterBtns = document.querySelectorAll(".contrib-filter-btn");
    newFilterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        newFilterBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.getAttribute("data-filter");

        rows.forEach(row => {
          const type = row.getAttribute("data-type");
          if (filter === "all" || type === filter) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });
    });
  }

  document.addEventListener("DOMContentLoaded", setupContribFilters);
