{
  "dependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.1",
    "sass": "^1.102.0",
    "sortablejs": "^1.15.6"
  },
  "scripts": {
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application-unpurged.css --no-source-map --load-path=node_modules --load-path=vendor/assets/stylesheets --load-path=app/assets/stylesheets && postcss ./app/assets/builds/application-unpurged.css -o ./app/assets/builds/application.css",
    "watch:css": "concurrently \"sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application-unpurged.css --no-source-map --load-path=node_modules --load-path=vendor/assets/stylesheets --load-path=app/assets/stylesheets --watch\" \"postcss ./app/assets/builds/application-unpurged.css -o ./app/assets/builds/application.css --watch\""
  }
}