02z"/></svg>                </div>
                <span class="filter-btn-text">
                  <% if params[:country].present? %>
                    <%= params[:country].size %> pays
                  <% else %>
                    <%= t('search.country', default: 'Pays') %>
                  <% end %>
                </span>
              </div>
              <svg class="filter-btn-chevron-svg" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="dropdown-menu" data-dropdown-target="menu" data-controller="prevent-scroll">
              <div class="domain-dropdown-menu-list" data-controller="prevent-scroll">
                <% @countries.all.each do |p| %>
                  <% is_checked = params[:country]&.include?(p.id.to_s) %>
                  <label class="domain-choice-pill <%= 'selected' if is_checked %>">
                    <input type="checkbox" name="country[]" value="<%= p.id %>" <%= 'checked' if is_checked %> class="hidden-checkbox" onchange="this.parentElement.classList.toggle('selected', this.checked)">
                    <span class="domain-text"><%= p.country %></span>
                    <span class="country-flag-emoji"><%= country_flag_emoji(p.country) %></span>
                  </label>
                <% end %>
              </div>
              <button type="button" class="button dark" data-action="click->tabs-search#update" style="width: 100%;">
                <%= t('search.apply', default: 'Appliquer') %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /search-filters-header -->
    <div class="search-filter filter-btn <%= 'active' if params[:sort].present? %>" data-controller="dropdown" id="sortFilterContainer" data-tabs-search-target="sortFilter" style="display:none; margin-bottom: 24px;">
      <div class="dropdown">
        <button type="button" class="dropdown-toggle mega-menu-btn <%= 'has-selection' if params[:sort].present? %>" data-dropdown-target="toggle">
          <div class="filter-btn-content">
            <div class="filter-btn-icon">
              <svg width="16" height="16" clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m8.656 5.778c0 .414.336.75.75.75h5.16c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-5.16c-.414 0-.75.336-.75.75zm-2.206 4c0 .414.336.75.75.75h9.596c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-9.596c-.414 0-.75.336-.75.75zm-2.45 4c0 .414.336.75.75.75h14.5c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-14.5c-.414 0-.75.336-.75.75zm-2 4c0 .414.336.75.75.75h18.5c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-18.5c-.414 0-.75.336-.75.75z" fill-rule="nonzero"/></svg>
            </div>
            <span class="filter-btn-text" data-tabs-search-target="sortSelectDisplay">
              Trier par
            </span>
          </div>
          <svg class="filter-btn-chevron-svg" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dropdown-menu" data-dropdown-target="menu" data-controller="prevent-scroll">
          <div class="domain-dropdown-menu-list" data-tabs-search-target="sortSelect">
            <!-- Options injectées par JS -->
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <div id="references" class="content-tab" data-tabs-search-target="tabContent" style="<%= params[:tab].blank? || params[:tab] == 'references' ? 'display:block;' : 'display:none;' %>">
    <div id="references-container" class="flex-container">
      <% inject_search_ads(@references, @ads).each do |item| %>
        <% if item.is_a?(Hash) && item[:_is_ad] %>
          <%= render 'search/ad_search_card', ad: item[:ad] %>
        <% else %>
          <%= render 'references/reference_card', reference: item %>
        <% end %>
      <% end %>
    </div>
    <% unless params[:tab] == "frise" %>
      <%= paginate @references, params: { tab: 'references' }, window: 1, outer_window: 1 %>
    <% end %>
  </div>
  <div id="studios" class="content-tab" data-tabs-search-target="tabContent" style="<%= params[:tab] == 'studios' ? 'display:block;' : 'display:none;' %>">
    <div id="studios-container" class="flex-container">
      <% inject_search_ads(@studios, @ads).each do |item| %>
        <% if item.is_a?(Hash) && item[:_is_ad] %>
          <%= render 'search/ad_search_card', ad: item[:ad] %>
        <% else %>
          <%= render 'studios/studio_card', studio: item %>
        <% end %>
      <% end %>
    </div>
    <% unless params[:tab] == "frise" %>
      <%= paginate @studios, params: { tab: 'studios' }, window: 1, outer_window: 1 %>
    <% end %>
  </div>
  <div id="designers" class="content-tab" data-tabs-search-target="tabContent" style="<%= params[:tab] == 'designers' ? 'display:block;' : 'display:none;' %>">
    <div id="designers-container" class="flex-container">
      <% inject_search_ads(@designers, @ads).each do |item| %>
        <% if item.is_a?(Hash) && item[:_is_ad] %>
          <%= render 'search/ad_search_card', ad: item[:ad] %>
        <% else %>
          <%= render 'designers/designer_card', designer: item %>
        <% end %>
      <% end %>
    </div>
    <% unless params[:tab] == "frise" %>
      <%= paginate @designers, params: { tab: 'designers' }, window: 1, outer_window: 1 %>
    <% end %>
  </div>
  <div id="frise" class="content-tab" data-tabs-search-target="tabContent" style="<%= params[:tab] == 'frise' ? 'display:block;' : 'display:none;' %>">
    <turbo-frame id="frise_timeline" <%= "src='#{search_path(request.query_parameters.merge(tab: 'frise'))}' loading='lazy'".html_safe if params[:tab] != 'frise' %>>
                      <% if params[:tab] == 'frise' %>
                        <% references_by_year = @references.group_by { |r| r.date_reference.to_i } %>
                        <% designers_by_year = @designers.group_by { |d| d.date_naissance.to_i } %>
                        <% studios_by_year = @studios.group_by { |s| s.date_creation.to_i } %>
                        <div data-controller="sub-tabs">
      <div class="tabs sub-tabs" style="margin-bottom: 20px;">
        <button class="tab active" data-sub-tabs-target="tab" data-sub-tab="references" data-action="click->sub-tabs#switch">
          <%= t('global.references') %>
        </button>
        <button class="tab" data-sub-tabs-target="tab" data-sub-tab="designers" data-action="click->sub-tabs#switch">
          <%= t('global.designers') %>
        </button>
        <button class="tab" data-sub-tabs-target="tab" data-sub-tab="studios" data-action="click->sub-tabs#switch">
          Studios
        </button>
      </div>
      <div data-sub-tabs-target="content" data-sub-tab="references">
        <div class="timeline" data-tabs-search-target="timeline" data-controller="timeline">
          <% @timeline_years.each do |year| %>
            <% references_year = references_by_year[year] || [] %>
            <% if references_year.any? %>
              <div class="timeline-item">
                <div class="references">
                  <div class="references-container">
                    <% if references_year.size > 1 %>
                      <div class="references-counter" data-controller="references-counter">
                        <span class="circle-with-number" data-action="click->references-counter#toggle">+<%= references_year.size %></span>
                        <div class="hidden-references" data-references-counter-target="hiddenReferences" style="display: none;">
                          <% references_year.each do |reference| %>
                            <%= link_to reference, class: "reference-point", data: { turbo_frame: "_top" } do %>
                              <% if reference.reference_images.first&.file&.attached? %>
                                <div class="reference" title="<%= reference.nom_reference %>" data-year="<%= reference.date_reference %>" style="background-image: url('<%= url_for(reference.reference_images.first.file.variant(:thumb))  %>');"></div>
                              <% else %>
                                <div class="reference" title="<%= reference.nom_reference %>" data-year="<%= reference.date_reference %>" style="background-color: #D9D9D9;"></div>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <% references_year.each do |reference| %>
                        <%= link_to reference, class: "reference-point", data: { turbo_frame: "_top" } do %>
                          <% if reference.reference_images.first&.file&.attached? %>
                            <div class="reference" title="<%= reference.nom_reference %>" data-year="<%= reference.date_reference %>" style="background-image: url('<%= url_for(reference.reference_images.first.file.variant(:thumb))  %>');"></div>
                          <% else %>
                            <div class="reference" title="<%= reference.nom_reference %>" data-year="<%= reference.date_reference %>" style="background-color: #D9D9D9;"></div>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="reference empty"></div>
                  <div class="year"><%= year %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div data-sub-tabs-target="content" data-sub-tab="designers" style="display: none;">
        <div class="timeline" data-tabs-search-target="timeline" data-controller="timeline">
          <% @timeline_years.each do |year| %>
            <% designers_year = designers_by_year[year] || [] %>
            <% if designers_year.any? %>
              <div class="timeline-item">
                <div class="references">
                  <div class="references-container">
                    <% if designers_year.size > 1 %>
                      <div class="references-counter" data-controller="references-counter">
                        <span class="circle-with-number" data-action="click->references-counter#toggle">+<%= designers_year.size %></span>
                        <div class="hidden-references" data-references-counter-target="hiddenReferences" style="display: none;">
                          <% designers_year.each do |designer| %>
                            <%= link_to designer, class: "reference-point", data: { turbo_frame: "_top" } do %>
                              <% if designer.designer_images.first&.file&.attached? %>
                                <div class="reference" title="<%= designer.nom_designer %>" data-year="<%= designer.date_naissance %>" style="background-image: url('<%= url_for(designer.designer_images.first.file.variant(:thumb))  %>');"></div>
                              <% else %>
                                <div class="reference" title="<%= designer.nom_designer %>" data-year="<%= designer.date_naissance %>" style="background-color: #D9D9D9;"></div>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <% designers_year.each do |designer| %>
                        <%= link_to designer, class: "reference-point", data: { turbo_frame: "_top" } do %>
                          <% if designer.designer_images.first&.file&.attached? %>
                            <div class="reference" title="<%= designer.nom_designer %>" data-year="<%= designer.date_naissance %>" style="background-image: url('<%= url_for(designer.designer_images.first.file.variant(:thumb))  %>');"></div>
                          <% else %>
                            <div class="reference" title="<%= designer.nom_designer %>" data-year="<%= designer.date_naissance %>" style="background-color: #D9D9D9;"></div>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="reference empty"></div>
                  <div class="year"><%= year %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div data-sub-tabs-target="content" data-sub-tab="studios" style="display: none;">
        <div class="timeline" data-tabs-search-target="timeline" data-controller="timeline">
          <% @timeline_years.each do |year| %>
            <% studios_year = studios_by_year[year] || [] %>
            <% if studios_year.any? %>
              <div class="timeline-item">
                <div class="references">
                  <div class="references-container">
                    <% if studios_year.size > 1 %>
                      <div class="references-counter" data-controller="references-counter">
                        <span class="circle-with-number" data-action="click->references-counter#toggle">+<%= studios_year.size %></span>
                        <div class="hidden-references" data-references-counter-target="hiddenReferences" style="display: none;">
                          <% studios_year.each do |studio| %>
                            <%= link_to studio, class: "reference-point", data: { turbo_frame: "_top" } do %>
                              <% if studio.studio_images.first&.file&.attached? %>
                                <div class="reference" title="<%= studio.nom %>" data-year="<%= studio.date_creation %>" style="background-image: url('<%= url_for(studio.studio_images.first.file.variant(:thumb))  %>');"></div>
                              <% else %>
                                <div class="reference" title="<%= studio.nom %>" data-year="<%= studio.date_creation %>" style="background-color: #D9D9D9;"></div>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <% studios_year.each do |studio| %>
                        <%= link_to studio, class: "reference-point", data: { turbo_frame: "_top" } do %>
                          <% if studio.studio_images.first&.file&.attached? %>
                            <div class="reference" title="<%= studio.nom %>" data-year="<%= studio.date_creation %>" style="background-image: url('<%= url_for(studio.studio_images.first.file.variant(:thumb))  %>');"></div>
                          <% else %>
                            <div class="reference" title="<%= studio.nom %>" data-year="<%= studio.date_creation %>" style="background-color: #D9D9D9;"></div>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="reference empty"></div>
                  <div class="year"><%= year %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div style="text-align: center; padding: 40px; color: #666; width: 100%;">
      Chargement de la frise chronologique...
    </div>
  <% end %>
</turbo-frame>
</div>
</section>