<% unless native_app? %>
  <div id="smart-app-banner" class="smart-app-banner" style="display: none;">
    <div class="sab-content">
      <div class="sab-left">
        <button type="button" class="sab-close" id="sab-close-btn" aria-label="Fermer">&times;</button>
        <div class="sab-logo-wrapper">
          <%= image_tag "small_logo_white.svg", alt: "Omniscient Design", class: "sab-logo" %>
        </div>
        <div class="sab-text">
          <span class="sab-title">Omniscient Design</span>
          <span class="sab-subtitle">Ouvrir dans l'application</span>
        </div>
      </div>
      <button type="button" 
              class="sab-button" 
              id="sab-open-btn">
        Ouvrir
      </button>
    </div>
  </div>

  <script>
    (function() {
      function checkAndShowBanner() {
        var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        var isDismissed = sessionStorage.getItem('dismiss_smart_app_banner');
        var isNative = navigator.userAgent.indexOf('Turbo Native') !== -1;

        if (isMobile && !isDismissed && !isNative) {
          var banner = document.getElementById('smart-app-banner');
          if (banner) {
            banner.style.display = 'block';
            document.documentElement.classList.add('has-smart-app-banner');
          }
        }
      }

      document.addEventListener('turbo:load', checkAndShowBanner);
      document.addEventListener('DOMContentLoaded', checkAndShowBanner);

      document.addEventListener('click', function(e) {
        // Fermeture du bandeau
        if (e.target && (e.target.id === 'sab-close-btn' || e.target.closest('#sab-close-btn'))) {
          var banner = document.getElementById('smart-app-banner');
          if (banner) {
            banner.style.display = 'none';
            document.documentElement.classList.remove('has-smart-app-banner');
            sessionStorage.setItem('dismiss_smart_app_banner', 'true');
          }
          return;
        }

        // Clic sur Ouvrir : deep link avec fallback automatique vers les stores si l'app est désinstallée
        var openBtn = e.target && (e.target.id === 'sab-open-btn' || e.target.closest('#sab-open-btn'));
        if (openBtn) {
          e.preventDefault();
          var ua = navigator.userAgent || '';
          var isIOS = /iPhone|iPad|iPod/i.test(ua);
          var isAndroid = /Android/i.test(ua);
          var rawPath = "<%= j request.fullpath.sub(%r{^/}, '') %>";
          var iosStoreUrl = "https://apps.apple.com/app/id6754964970";
          var androidStoreUrl = "https://play.google.com/store/apps/details?id=com.thomasriq.omniscientdesign";

          if (isAndroid) {
            // Android intent : ouvre l'app ou redirige silencieusement vers Google Play
            var intentUrl = "intent://" + rawPath + "#Intent;scheme=omniscient;package=com.thomasriq.omniscientdesign;S.browser_fallback_url=" + encodeURIComponent(androidStoreUrl) + ";end";
            window.location.href = intentUrl;
          } else if (isIOS) {
            var deepLink = "omniscient://" + rawPath;
            var hasLeftPage = false;

            var onVisibility = function() {
              if (document.hidden || document.webkitHidden) {
                hasLeftPage = true;
              }
            };

            var onPageHide = function() {
              hasLeftPage = true;
              window.removeEventListener('pagehide', onPageHide);
              document.removeEventListener('visibilitychange', onVisibility);
            };

            window.addEventListener('pagehide', onPageHide, { once: true });
            document.addEventListener('visibilitychange', onVisibility);

            window.location.href = deepLink;

            // Si après 1.5s la page est toujours active, l'app n'est pas installée -> redirection vers l'App Store
            setTimeout(function() {
              document.removeEventListener('visibilitychange', onVisibility);
              window.removeEventListener('pagehide', onPageHide);

              if (!hasLeftPage && !document.hidden && !document.webkitHidden) {
                window.location.href = iosStoreUrl;
              }
            }, 1500);
          } else {
            window.location.href = iosStoreUrl;
          }
        }
      });
    })();
  </script>
<% end %>
