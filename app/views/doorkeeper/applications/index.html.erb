<div class="dk-page-header">
  <h1 class="dk-page-title"><%= t('.title') %></h1>
  <%= link_to t('.new'), new_oauth_application_path, class: 'button dark dk-btn-new' %>
</div>

<% if @applications.any? %>
  <div class="dk-apps-grid">
    <% @applications.each do |application| %>
      <div class="dk-app-card" id="application_<%= application.id %>">
        <div class="dk-app-card-header">
          <div class="dk-app-icon">
            <%= application.name.first.upcase %>
          </div>
          <div class="dk-app-card-info">
            <%= link_to application.name, oauth_application_path(application), class: 'dk-app-name' %>
            <span class="dk-app-confidential-badge <%= application.confidential? ? 'confidential' : 'public' %>">
              <%= application.confidential? ? t('doorkeeper.applications.index.confidentiality.yes') : t('doorkeeper.applications.index.confidentiality.no') %>
            </span>
          </div>
        </div>
        <div class="dk-app-card-body">
          <p class="dk-app-redirect">
            <span class="dk-app-label"><%= t('.callback_url') %></span>
            <code class="dk-app-code"><%= application.redirect_uri.presence || '—' %></code>
          </p>
        </div>
        <div class="dk-app-card-actions">
          <%= link_to t('doorkeeper.applications.buttons.edit'), edit_oauth_application_path(application), class: 'button dk-btn-sm' %>
          <%= render 'delete_form', application: application %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="dk-empty-state">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <p>Aucune application OAuth enregistrée.</p>
    <%= link_to 'Créer votre première application', new_oauth_application_path, class: 'button dark' %>
  </div>
<% end %>
