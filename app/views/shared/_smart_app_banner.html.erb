<% unless native_app? %>
  <div id="smart-app-banner" class="smart-app-banner" style="display: none;">
    <div class="sab-content">
      <div class="sab-left">
        <button type="button" class="sab-close" id="sab-close-btn" aria-label="Fermer">&times;</button>
        <div class="sab-logo-wrapper">
          <%= image_tag "small_logo_white.svg", alt: "Omniscient Design", class: "sab-logo" %>
        </div>
        <div class="sab-text">
          <span class="sab-title">Omniscient Design</span>
          <span class="sab-subtitle">Ouvrir dans l'application</span>
        </div>
      </div>
      <a href="omniscient://<%= request.fullpath.sub(%r{^/}, '') %>" 
         class="sab-button" 
         id="sab-open-btn"
         data-deep-link="omniscient://<%= request.fullpath.sub(%r{^/}, '') %>"
         data-ios-store="https://apps.apple.com/app/id6754964970"
         data-android-store="https://play.google.com/store/apps/details?id=com.thomasriq.omniscientdesign">
        Ouvrir
      </a>
    </div>
  </div>

  <script>
    (function() {
      function checkAndShowBanner() {
        var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        var isDismissed = sessionStorage.getItem('dismiss_smart_app_banner');
        var isNative = navigator.userAgent.indexOf('Turbo Native') !== -1;

        if (isMobile && !isDismissed && !isNative) {
          var banner = document.getElementById('smart-app-banner');
          if (banner) {
            banner.style.display = 'block';
            document.documentElement.classList.add('has-smart-app-banner');
          }
        }
      }

      document.addEventListener('turbo:load', checkAndShowBanner);
      document.addEventListener('DOMContentLoaded', checkAndShowBanner);

      document.addEventListener('click', function(e) {
        // Fermer la bannière
        if (e.target && (e.target.id === 'sab-close-btn' || e.target.closest('#sab-close-btn'))) {
          var banner = document.getElementById('smart-app-banner');
          if (banner) {
            banner.style.display = 'none';
            document.documentElement.classList.remove('has-smart-app-banner');
            sessionStorage.setItem('dismiss_smart_app_banner', 'true');
          }
          return;
        }

        // Clic sur le bouton Ouvrir
        var openBtn = e.target && (e.target.id === 'sab-open-btn' || e.target.closest('#sab-open-btn'));
        if (openBtn) {
          e.preventDefault();
          var deepLink = openBtn.getAttribute('data-deep-link');
          var isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
          var storeUrl = isIOS ? openBtn.getAttribute('data-ios-store') : openBtn.getAttribute('data-android-store');

          var start = Date.now();
          window.location.href = deepLink;

          // Si après 1.5s l'app ne s'est pas ouverte (donc non installée), on redirige vers l'App Store / Play Store
          setTimeout(function() {
            if (Date.now() - start < 2000 && !document.hidden) {
              window.location.href = storeUrl;
            }
          }, 1500);
        }
      });
    })();
  </script>
<% end %>
