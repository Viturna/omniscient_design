<div class="dk-page-header">
  <h1 class="dk-page-title"><%= t('.title') %></h1>
</div>

<div class="dk-form-wrapper">
  <%= form_for application, url: doorkeeper_submit_path(application), as: :doorkeeper_application, html: { role: 'form', class: 'dk-form' } do |f| %>
    <% if application.errors.any? %>
      <div class="dk-alert dk-alert-error">
        <%= t('doorkeeper.applications.form.error') %>
      </div>
    <% end %>

    <div class="dk-field">
      <%= f.label :name, class: 'dk-label' %>
      <%= f.text_field :name, class: "dk-input #{'dk-input-error' if application.errors[:name].present?}", required: true, placeholder: "Mon application" %>
      <%= doorkeeper_errors_for application, :name %>
    </div>

    <div class="dk-field">
      <%= f.label :redirect_uri, class: 'dk-label' %>
      <%= f.text_area :redirect_uri, class: "dk-input dk-textarea #{'dk-input-error' if application.errors[:redirect_uri].present?}", placeholder: "https://monapp.com/callback" %>
      <%= doorkeeper_errors_for application, :redirect_uri %>
      <span class="dk-field-hint"><%= t('doorkeeper.applications.help.redirect_uri') %></span>
      <% if Doorkeeper.configuration.allow_blank_redirect_uri?(application) %>
        <span class="dk-field-hint"><%= t('doorkeeper.applications.help.blank_redirect_uri') %></span>
      <% end %>
    </div>

    <div class="dk-field">
      <%= f.label :scopes, class: 'dk-label' %>
      <%= f.text_field :scopes, class: "dk-input #{'dk-input-error' if application.errors[:scopes].present?}", placeholder: "read write" %>
      <%= doorkeeper_errors_for application, :scopes %>
      <span class="dk-field-hint"><%= t('doorkeeper.applications.help.scopes') %></span>
    </div>

    <div class="dk-field dk-field-checkbox">
      <div class="dk-checkbox-wrapper">
        <%= f.check_box :confidential, class: 'dk-checkbox' %>
        <%= f.label :confidential, class: 'dk-checkbox-label' %>
      </div>
      <span class="dk-field-hint"><%= t('doorkeeper.applications.help.confidential') %></span>
    </div>

    <div class="dk-form-actions">
      <%= f.submit t('doorkeeper.applications.buttons.submit'), class: 'button dark' %>
      <%= link_to t('doorkeeper.applications.buttons.cancel'), oauth_applications_path, class: 'button' %>
    </div>
  <% end %>
</div>
