<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= t('doorkeeper.layouts.admin.title') %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
</head>
<body>
  <div class="dk-admin-layout">
    <nav class="dk-admin-nav">
      <div class="dk-admin-nav-inner">
        <%= link_to oauth_applications_path, class: 'dk-admin-brand' do %>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>OAuth</span>
        <% end %>
        <div class="dk-admin-nav-links">
          <% if respond_to?(:root_path) %>
            <%= link_to t('doorkeeper.layouts.admin.nav.home'), root_path, class: 'dk-admin-nav-link' %>
          <% end %>
          <%= link_to t('doorkeeper.layouts.admin.nav.applications'), oauth_applications_path, class: "dk-admin-nav-link #{'active' if request.path == oauth_applications_path}" %>
        </div>
      </div>
    </nav>

    <main class="dk-admin-main">
      <% if flash[:notice].present? %>
        <div class="dk-flash-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </div>
</body>
</html>
