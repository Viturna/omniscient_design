<div class="log" style="color:#FFF; min-height:100vh;">
  <section class="box-log">
    <div class="form">
      <h1 style="margin-top: 0;">Renvoyer les instructions de déblocage</h1>
      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>
        <div class="field">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Adresse e-mail" %>
        </div>
        <div class="actions">
          <%= f.submit "Renvoyer", class: "button dark btn-login" %>
        </div>
        <%= link_to t('devise.confirmation.login_link'), new_user_session_path, class: "sign-up-in" %>
      <% end %>
    </div>
  </section>
</div>
