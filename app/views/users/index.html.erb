<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartkick"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />
<div class="users-dash-wrapper">
  <div class="users-dash-header">
    <div style="display: flex; align-items: center; gap: 20px;">
      <%= link_to admin_root_path, class: "users-dash-back-link" do %>
        <svg style="width: 24px; height: 24px; fill: #202020;" viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      <% end %>
      <h1 class="users-dash-title"><%= t('admin.users.index.title') %></h1>
    </div>
    <div class="users-dash-header-actions">
      <%= form_with url: users_path, method: :get, local: true, class: "custom-period-form" do |f| %>
        <%= f.date_field :start_date, value: params[:start_date], class: "period-date-input" %>
        <span class="period-separator">-</span>
        <%= f.date_field :end_date, value: params[:end_date], class: "period-date-input" %>
        <%= f.submit "Valider", class: "period-btn #{@period == 'custom' ? 'active' : ''} period-submit-btn" %>
      <% end %>
      <div class="users-dash-period-selector">
        <%= link_to "7J", users_path(period: '7d'), class: "period-btn #{@period == '7d' ? 'active' : ''}" %>
        <%= link_to "30J", users_path(period: '30d'), class: "period-btn #{@period == '30d' ? 'active' : ''}" %>
        <%= link_to "60J", users_path(period: '60d'), class: "period-btn #{@period == '60d' ? 'active' : ''}" %>
        <%= link_to "90J", users_path(period: '90d'), class: "period-btn #{@period == '90d' ? 'active' : ''}" %>
        <%= link_to "12M", users_path(period: '12m'), class: "period-btn #{@period == '12m' ? 'active' : ''}" %>
      </div>
    </div>
  </div>
  <div class="users-dash-kpi-grid">
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.users.index.total_members') %></span>
        <div class="kpi-icon bg-blue-light">
          <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        </div>
      </div>
      <div style="margin-top: auto;">
        <span class="kpi-value"><%= @total_users %></span>
      </div>
    </div>
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.users.index.new_members') %> (<%= @period %>)</span>
        <div class="kpi-icon bg-green-light">
          <svg viewBox="0 0 24 24"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>
        </div>
      </div>
      <div style="margin-top: auto;">
        <span class="kpi-value" style="color: #2E7D32;">+<%= @new_users_period %></span>
      </div>
    </div>
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.users.index.active_members') %> (<%= @period %>)</span>
        <div class="kpi-icon bg-orange-light">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        </div>
      </div>
      <div style="margin-top: auto;">
        <span class="kpi-value"><%= @active_users_period %></span>
      </div>
    </div>
    <div class="users-dash-kpi-card">
      <div class="kpi-top">
        <span class="kpi-label"><%= t('admin.users.index.newsletter') %></span>
        <div class="kpi-icon bg-yellow-light">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </div>
      </div>
      <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
          <span class="kpi-value"><%= @newsletter_count %></span>
          <div style="font-size: 13px; color: #666; font-weight: 500;"><%= t('admin.users.index.out_of_members', count: @total_users) %></div>
        </div>
        <%= link_to export_newsletter_users_path(format: :csv), class: "kpi-export-action", title: t('admin.users.index.export_csv'), data: { turbo: false } do %>
          <svg viewBox="0 0 24 24"><path d="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z"/></svg>
        <% end %>
      </div>
    </div>
  </div>
  <div class="users-dash-main-chart-section">
    <div class="chart-header">
      <div class="chart-tabs">
        <div class="chart-tab active" onclick="switchChart('signups', this)"><%= t('admin.users.index.signups') %></div>
        <div class="chart-tab" onclick="switchChart('visits', this)"><%= t('admin.users.index.visits') %></div>
        <div class="chart-tab" onclick="switchChart('acquisition', this)"><%= t('admin.users.index.acquisition') %></div>
      </div>
    </div>
    <div id="chart-signups" class="chart-container active">
      <%= area_chart @chart_signups, height: "300px", colors: ["#202020"], library: { scales: { x: { grid: { display: false } }, y: { grid: { borderDash: [5, 5] } } } } %>
    </div>
    <div id="chart-visits" class="chart-container">
      <%= area_chart @chart_visits, height: "300px", colors: ["#4CAF50"], library: { scales: { x: { grid: { display: false } }, y: { grid: { borderDash: [5, 5] } } } } %>
    </div>
    <div id="chart-acquisition" class="chart-container">
      <%= line_chart @chart_acquisition, height: "300px", library: { scales: { x: { grid: { display: false } }, y: { grid: { borderDash: [5, 5] } } } } %>
    </div>
  </div>
  <div class="users-dash-secondary-grid">
    <div class="secondary-card">
      <span class="secondary-title"><%= t('admin.users.index.acquisition') %></span>
      <%= pie_chart @distrib_acquisition, donut: true, height: "200px", colors: ["#202020", "#666", "#999", "#ccc", "#eee"], legend: "bottom" %>
    </div>
    <div class="secondary-card">
      <span class="secondary-title"><%= t('admin.users.index.status_distribution') %></span>
      <%= pie_chart @distrib_statut, donut: true, height: "200px", colors: ["#2E7D32", "#1565C0", "#F9A825"], legend: "bottom" %>
    </div>
    <div class="secondary-card span-2">
      <span class="secondary-title">Niveau d'études</span>
      <%= column_chart @distrib_levels, height: "400px", colors: ["#202020"], library: { scales: { x: { grid: { display: false } }, y: { grid: { borderDash: [5, 5] } } } } %>
    </div>
  </div>
  <div class="users-dash-toolbar">
    <%= form_with url: users_path, method: :get, local: true, id: "usersFilterForm", class: "users-dash-filter-form" do |f| %>
      <%= hidden_field_tag :period, @period %>
      <%= hidden_field_tag :direction, params[:direction] %>
      
      <div class="users-dash-search-wrapper">
        <div class="users-dash-search">
          <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <%= f.text_field :query, value: params[:query], placeholder: "Rechercher un membre par nom, prénom, email, pseudo..." %>
        </div>
        <% if params[:query].present? || params[:statut].present? || params[:platform].present? || params[:role].present? || params[:etablissement_id].present? || params[:source].present? || params[:sort].present? || params[:visits].present? %>
          <%= link_to users_path(period: @period), class: "btn-reset-filters", title: "Réinitialiser tous les filtres" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Effacer les filtres
          <% end %>
        <% end %>
      </div>

      <div class="users-dash-filters-row">
        <!-- Statut Filter -->
        <div class="filter-pill-item <%= 'active' if params[:statut].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <%= f.select :statut, options_for_select([["Tous les statuts", ""]] + User::STATUTS.map { |s| [s.capitalize, s] }, params[:statut]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Plateforme Filter -->
        <div class="filter-pill-item <%= 'active' if params[:platform].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/></svg>
          </div>
          <%= f.select :platform, options_for_select([["Toutes plateformes", ""], ["📱 App Mobile", "app"], ["💻 Web uniquement", "web"]], params[:platform]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Établissement Filter -->
        <div class="filter-pill-item filter-pill-large <%= 'active' if params[:etablissement_id].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
          </div>
          <%= f.select :etablissement_id, options_for_select([["Tous les établissements", ""]] + @etablissements_for_filter.map { |e| [e.name, e.id] }, params[:etablissement_id]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Source Filter -->
        <div class="filter-pill-item <%= 'active' if params[:source].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          </div>
          <%= f.select :source, options_for_select([["Toutes les sources", ""]] + @sources_for_filter.map { |s| [s, s] }, params[:source]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Visites Filter -->
        <div class="filter-pill-item <%= 'active' if params[:visits].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
          </div>
          <%= f.select :visits, options_for_select([
                ["Toutes les visites", ""],
                ["Jamais connecté", "0"],
                ["1 à 5 visites", "1-5"],
                ["5 à 20 visites", "5-20"],
                ["Plus de 20 visites", "20+"]
              ], params[:visits]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <!-- Tri Select -->
        <div class="filter-pill-item filter-pill-sort <%= 'active' if params[:sort].present? %>">
          <div class="filter-pill-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/></svg>
          </div>
          <%= f.select :sort, options_for_select([
                ["Trier par...", ""],
                ["Badges (Plus récompensés)", "badges_desc"],
                ["Badges (Moins récompensés)", "badges_asc"],
                ["Établissement (A-Z)", "etablissement_asc"],
                ["Établissement (Z-A)", "etablissement_desc"],
                ["Date d'inscription (Plus récent)", "inscription_desc"],
                ["Date d'inscription (Plus ancien)", "inscription_asc"],
                ["Nom (A-Z)", "nom_asc"],
                ["Nom (Z-A)", "nom_desc"],
                ["Visites (Plus actifs)", "visites_desc"],
                ["Visites (Moins actifs)", "visites_asc"]
              ], params[:sort]), {}, { class: "filter-pill-select", onchange: "this.form.submit()" } %>
          <div class="filter-pill-chevron">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%= turbo_frame_tag "members_table" do %>
    <div class="users-dash-table-container">
      <table class="users-dash-table">
        <thead>
          <%
            def sort_header(column, label)
              is_active = (params[:sort] == column)
              next_direction = (is_active && params[:direction] == "asc") ? "desc" : "asc"
              arrow = is_active ? (params[:direction] == "asc" ? " ↑" : " ↓") : ""
              link_to users_path(
                period: @period,
                query: params[:query],
                statut: params[:statut],
                platform: params[:platform],
                etablissement_id: params[:etablissement_id],
                source: params[:source],
                role: params[:role],
                sort: column,
                direction: next_direction
              ), style: "text-decoration: none; color: #{is_active ? '#202020' : '#666'}; font-weight: 500;", data: { turbo_frame: "members_table" } do
                "#{label}#{arrow}".html_safe
              end
            end
          %>
          <tr>
            <th><%= sort_header("utilisateur", "Utilisateur") %></th>
            <th><%= sort_header("statut", "Statut") %></th>
            <th>Plateforme</th>
            <th><%= sort_header("study_level", "Niveau d'études") %></th>
            <th><%= sort_header("etablissement", "Établissement") %></th>
            <th><%= sort_header("source", "Source") %></th>
            <th><%= sort_header("inscription", "Inscription") %></th>
            <th><%= sort_header("visites", "Visites") %></th>
            <th><%= sort_header("badges", "Badges") %></th>
            <th style="text-align: right; padding-right: 32px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @paginated_users.each do |user| %>
            <tr class="clickable-user-row" data-href="<%= user_path(user) %>">
              <td>
                <div style="display:flex; align-items:center;">
                  <div class="users-dash-avatar">
                    <% if user.profile_image.present? %>
                      <%= image_tag user.profile_image, 
                            alt: user.firstname,
                            onerror: "this.style.display='none'; if(this.nextElementSibling){this.nextElementSibling.style.display='flex';}" %>
                      <span style="display: none;"><%= user.firstname&.first %></span>
                    <% else %>
                      <%= user.firstname&.first %>
                    <% end %>
                  </div>
                  <div>
                    <div style="font-weight: 500; color: #202020;"><%= user.firstname %> <%= user.lastname %></div>
                    <div style="font-size: 12px; color: #888;"><%= user.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge badge-<%= user.statut == 'Etudiant' ? 'blue' : 'green' %>">
                  <%= user.statut || "N/A" %>
                </span>
                <% if user.admin? %>
                  <span class="badge badge-dark">Admin</span>
                <% end %>
              </td>
              <td>
                <% if user.user_devices.any? %>
                  <span class="badge" style="background: #F3E5F5; color: #7B1FA2; display: inline-flex; align-items: center; gap: 4px;" title="Connecté sur l'application mobile">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/></svg>
                    App
                  </span>
                <% else %>
                  <span class="badge" style="background: #F5F5F5; color: #666; display: inline-flex; align-items: center; gap: 4px;" title="Utilise uniquement le site web">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>
                    Web
                  </span>
                <% end %>
              </td>
              <td><%= user.study_level.presence || "-" %></td>
              <td>
                <% if user.etablissement.present? %>
                  <div style="font-weight: 500; color: #202020; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= user.etablissement.name %>">
                    <%= user.etablissement.name %>
                  </div>
                  <div style="font-size: 12px; color: #888;">
                    <%= user.etablissement.city %>
                    <% if user.etablissement.academy.present? %>
                      • Académie de <%= user.etablissement.academy %>
                    <% end %>
                  </div>
                <% else %>
                  <span style="color: #bbb;">-</span>
                <% end %>
              </td>
              <td><%= user.how_did_you_hear.presence || "-" %></td>
              <td>
                <%= user.created_at.strftime("%d/%m/%Y") %>
                <div style="font-size: 11px; color: #999;"><%= time_ago_in_words(user.created_at) %></div>
              </td>
              <td>
                <% visits_count = user.daily_visits.size %>
                <span style="font-weight: 500; color: <%= visits_count == 0 ? '#bbb' : visits_count > 20 ? '#2E7D32' : '#202020' %>;">
                  <%= visits_count %>
                </span>
                <% if visits_count > 20 %>
                  <span style="font-size: 11px; color: #2E7D32;">🔥 très actif</span>
                <% elsif visits_count == 0 %>
                  <span style="font-size: 11px; color: #bbb;">jamais connecté</span>
                <% end %>
              </td>
              <td>
                <% badges_count = user.respond_to?(:badges_count) ? user.badges_count.to_i : user.user_badges.size %>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 16px;">🏆</span>
                  <span style="font-weight: 500; color: <%= badges_count == 0 ? '#bbb' : '#202020' %>;">
                    <%= badges_count %>
                  </span>
                </div>
              </td>
              <td style="text-align: right;">
                <%= link_to user_path(user), style: "text-decoration:none;", data: { turbo_frame: "_top" } do %>
                  <div style="width: 32px; height: 32px; display:inline-flex; align-items:center; justify-content:center; border:1px solid #eee; border-radius:8px; background:#fff; cursor: pointer;">
                    <svg style="width:16px; height:16px; fill:#202020;" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div style="padding: 24px; display: flex; justify-content: center; border-top: 1px solid #eee;">
        <%= paginate @paginated_users %>
      </div>
    </div>
  <% end %>
  <div class="users-dash-map-section">
    <div class="users-dash-map-header">
      <span class="users-dash-map-title">Géolocalisation des membres</span>
    </div>
    <div id="map"></div>
  </div>
</div>
<script>
  // Tabs Graphique
  function switchChart(chartId, tabElement) {
    document.querySelectorAll('.chart-container').forEach(el => el.classList.remove('active'));
    document.getElementById('chart-' + chartId).classList.add('active');
    document.querySelectorAll('.chart-tab').forEach(el => el.classList.remove('active'));
    tabElement.classList.add('active');
  }

  // Initialisation Carte
  document.addEventListener("turbo:load", () => {
    const mapElement = document.getElementById('map');
    if (mapElement && !mapElement._leaflet_id && typeof L !== 'undefined') {
      const map = L.map('map').setView([46.603354, 1.888334], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
      }).addTo(map);

      const markers = L.markerClusterGroup();
      const userLocations = [
        <% @users_for_map.each do |user| %>
          <% if user.etablissement&.latitude && user.etablissement&.longitude %>
            { lat: <%= user.etablissement.latitude %>, lng: <%= user.etablissement.longitude %>, name: "<%= j user.firstname %> <%= j user.lastname %>" },
          <% end %>
        <% end %>
      ];

      userLocations.forEach(u => {
        markers.addLayer(L.marker([u.lat, u.lng]).bindPopup(`<b>${u.name}</b>`));
      });
      map.addLayer(markers);
    }
  });

  // Ligne de tableau cliquable
  document.addEventListener("click", function(e) {
    const row = e.target.closest("tr.clickable-user-row");
    if (!row) return;
    if (e.target.closest("a, button, input, select, form, label")) return;

    const href = row.getAttribute("data-href");
    if (href) {
      if (window.Turbo) {
        window.Turbo.visit(href);
      } else {
        window.location.href = href;
      }
    }
  });
</script>