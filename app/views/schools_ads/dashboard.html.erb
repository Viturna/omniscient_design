<% content_for :title, "Espace Annonceur & Campagnes | Omniscient Design for professionals" %>

<div class="sa-dash">
  <!-- Top Navigation Header -->
  <header class="sa-dash__header">
    <div class="sa-dash__header-left">
      <a href="<%= sa_root_path %>" class="sa-dash__brand">
        <%= image_tag "logo.svg", alt: "Logo Omniscient Design", class: "sa-dash__brand-logo" %>
        <div class="sa-dash__brand-info">
          <span class="sa-dash__brand-name">Omniscient Design</span>
          <span class="sa-dash__brand-tag">for professionals</span>
        </div>
      </a>
    </div>

    <div class="sa-dash__header-right">
      <div class="sa-dash__user-badge">
        <% school_display_name = @user&.etablissement&.name.presence || @user&.firstname.presence || @user&.email.presence || "Partenaire" %>
        <span class="sa-dash__user-avatar">
          <%= school_display_name[0..1].to_s.upcase %>
        </span>
        <div class="sa-dash__user-text">
          <span class="sa-dash__user-name"><%= school_display_name %></span>
          <span class="sa-dash__user-email"><%= @user&.email %></span>
        </div>
      </div>

      <%= link_to (request.subdomain.to_s.include?('schools-ads') ? schools_ads_billing_portal_path : schools_ads_direct_billing_portal_path), class: "sa-dash__btn-pill", title: "Gérer la facturation & télécharger mes reçus Stripe" do %>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
          <line x1="1" y1="10" x2="23" y2="10"></line>
        </svg>
        <span>Facturation & Reçus</span>
      <% end %>

      <a href="<%= sa_funnel_path %>" class="sa-dash__btn-pill sa-dash__btn-pill--dark">
        <span>+ Nouvelle campagne</span>
      </a>

      <%= button_to destroy_user_session_path, method: :delete, class: "sa-dash__btn-logout", title: "Déconnexion" do %>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      <% end %>
    </div>
  </header>

  <!-- Main Container -->
  <main class="sa-dash__main">
    <div class="sa-dash__intro">
      <h1 class="sa-dash__title">Tableau de bord de vos campagnes</h1>
      <p class="sa-dash__subtitle">
        Suivez la diffusion de vos annonces, vos performances d'audience et gérez vos visuels en temps réel.
      </p>
    </div>

    <!-- Alert Modération Info -->
    <% if @pending_ads_count.positive? %>
      <div class="sa-dash__alert">
        <div class="sa-dash__alert-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="sa-dash__alert-content">
          <strong>Modération en cours :</strong> Vous avez <strong><%= @pending_ads_count %> campagne(s) en cours de validation</strong> par notre équipe (délai : 24h ouvrées).
        </div>
      </div>
    <% end %>

    <!-- KPI Grid -->
    <div class="sa-dash__kpi-grid">
      <div class="sa-dash__kpi-card">
        <div class="sa-dash__kpi-head">
          <span class="sa-dash__kpi-label">Campagnes Actives</span>
          <span class="sa-dash__kpi-dot sa-dash__kpi-dot--active"></span>
        </div>
        <div class="sa-dash__kpi-value">
          <%= @active_ads_count %>
          <span class="sa-dash__kpi-sub">/ <%= @ads.count %></span>
        </div>
      </div>

      <div class="sa-dash__kpi-card">
        <div class="sa-dash__kpi-head">
          <span class="sa-dash__kpi-label">Vues (Impressions)</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <div class="sa-dash__kpi-value"><%= number_with_delimiter(@total_impressions, delimiter: " ") %></div>
      </div>

      <div class="sa-dash__kpi-card">
        <div class="sa-dash__kpi-head">
          <span class="sa-dash__kpi-label">Clics Générés</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2">
            <path d="M15 3h6v6"></path>
            <path d="M10 14L21 3"></path>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          </svg>
        </div>
        <div class="sa-dash__kpi-value"><%= number_with_delimiter(@total_clicks, delimiter: " ") %></div>
      </div>

      <div class="sa-dash__kpi-card">
        <div class="sa-dash__kpi-head">
          <span class="sa-dash__kpi-label">Taux d'Engagement</span>
          <span style="font-size: 11px; font-weight: 600; color: #888888;">CTR</span>
        </div>
        <div class="sa-dash__kpi-value"><%= @avg_ctr %> <span style="font-size: 18px; font-weight: 500; color: #888888;">%</span></div>
      </div>
    </div>

    <!-- Campaigns Section -->
    <div class="sa-dash__section">
      <div class="sa-dash__section-head">
        <div>
          <h2 class="sa-dash__section-title">Vos Annonces & Campagnes</h2>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <button type="button" class="sa-dash__btn-support" onclick="document.getElementById('sa-support-modal').style.display='flex'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Contacter l'équipe</span>
          </button>
          <span class="sa-dash__count-badge"><%= @ads.count %> au total</span>
        </div>
      </div>

      <% if @ads.any? %>
        <div class="sa-dash__campaigns-list">
          <% @ads.each do |ad| %>
            <% 
              is_active = ad.currently_running?
              is_pending = ad.status == 'pending_validation'
              is_rejected = ad.status == 'rejected'
              is_future = ad.start_date.present? && ad.start_date > Date.current
              is_expired = ad.end_date.present? && ad.end_date < Date.current
              ctr = ad.impressions_count.to_i > 0 ? ((ad.clicks_count.to_f / ad.impressions_count) * 100).round(2) : 0
            %>
            <article class="sa-camp-card">
              <!-- Visual Thumbnail -->
              <div class="sa-camp-card__media">
                <% if ad.image.attached? %>
                  <% if ad.video? %>
                    <video src="<%= url_for(ad.image) %>" class="sa-camp-card__img" muted loop autoplay playsinline></video>
                  <% else %>
                    <%= image_tag ad.image, class: "sa-camp-card__img", alt: ad.title %>
                  <% end %>
                <% else %>
                  <div class="sa-camp-card__img sa-camp-card__img--placeholder">
                    <span>Aucun visuel</span>
                  </div>
                <% end %>
                <span class="sa-camp-card__format-tag">Sponsorisé</span>
              </div>

              <!-- Main Campaign Details -->
              <div class="sa-camp-card__body">
                <div class="sa-camp-card__top">
                  <div>
                    <h3 class="sa-camp-card__title"><%= ad.title %></h3>
                    <% if ad.stripe_subscription_id.present? %>
                      <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 500; color: #166534; background: #F0FDF4; border: 1px solid #BBF7D0; padding: 2px 8px; border-radius: 9999px; margin-top: 5px;">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Abonnement mensuel actif (<%= (ad.price_paid.to_i / 100) %>€/mois)
                      </span>
                    <% end %>
                  </div>

                  <!-- Dynamic Status Badge -->
                  <div class="sa-camp-card__status">
                    <% if is_pending %>
                      <span class="sa-status-badge sa-status-badge--pending">
                        <span class="sa-status-dot sa-status-dot--pulse-amber"></span>
                        En attente de validation
                      </span>
                    <% elsif is_rejected %>
                      <span class="sa-status-badge sa-status-badge--rejected">
                        <span class="sa-status-dot sa-status-dot--red"></span>
                        Visuel non conforme
                      </span>
                    <% elsif is_active %>
                      <span class="sa-status-badge sa-status-badge--active">
                        <span class="sa-status-dot sa-status-dot--pulse-green"></span>
                        En cours de diffusion
                      </span>
                    <% elsif is_future %>
                      <span class="sa-status-badge sa-status-badge--scheduled">
                        <span class="sa-status-dot sa-status-dot--blue"></span>
                        Planifiée
                      </span>
                    <% else %>
                      <span class="sa-status-badge sa-status-badge--expired">
                        <span class="sa-status-dot sa-status-dot--gray"></span>
                        Campagne terminée
                      </span>
                    <% end %>
                  </div>
                </div>

                <% if ad.description.present? %>
                  <p class="sa-camp-card__desc"><%= ad.description %></p>
                <% end %>

                <div class="sa-camp-card__meta-grid">
                  <div class="sa-camp-card__meta-item">
                    <span class="sa-camp-card__meta-label">Lien :</span>
                    <a href="<%= ad.link %>" target="_blank" rel="noopener noreferrer" class="sa-camp-card__link">
                      <%= ad.link.truncate(38) %>
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                  </div>

                  <div class="sa-camp-card__meta-item">
                    <span class="sa-camp-card__meta-label">Période :</span>
                    <span class="sa-camp-card__meta-value">
                      <% if ad.start_date.present? && ad.end_date.present? %>
                        Du <strong><%= ad.start_date.strftime("%d/%m/%Y") %></strong> au <strong><%= ad.end_date.strftime("%d/%m/%Y") %></strong>
                        (<%= ad.duration_days.presence || ((ad.end_date - ad.start_date).to_i + 1) %> jours)
                      <% else %>
                        Diffusion continue
                      <% end %>
                    </span>
                  </div>
                </div>

                <!-- Action de modification & Résiliation -->
                <div style="margin-top: 14px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
                  <button type="button" 
                          class="sa-camp-card__btn-modify" 
                          onclick="openModificationModal('<%= j(ad.title) %>', '<%= ad.id %>')">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    <span>Modifier l'annonce</span>
                  </button>

                  <% if ad.stripe_customer_id.present? %>
                    <%= link_to (request.subdomain.to_s.include?('schools-ads') ? schools_ads_billing_portal_path(ad_id: ad.id) : schools_ads_direct_billing_portal_path(ad_id: ad.id)), class: "sa-camp-card__btn-modify", title: "Facturation & reçus de cette annonce" do %>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                      <span>Reçus & Carte</span>
                    <% end %>
                  <% end %>

                  <% if ad.stripe_subscription_id.present? && ad.subscription_status != 'canceled' && ad.subscription_status != 'canceling' %>
                    <%= button_to (request.subdomain.to_s.include?('schools-ads') ? schools_ads_cancel_subscription_path(ad) : schools_ads_direct_cancel_subscription_path(ad)),
                        method: :post,
                        data: { turbo_confirm: "Êtes-vous sûr de vouloir résilier l'abonnement de cette campagne ? Elle restera active jusqu'à la fin du mois en cours et aucun prélèvement suivant ne sera effectué." },
                        class: "sa-camp-card__btn-cancel-sub" do %>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                      <span>Résilier l'abonnement</span>
                    <% end %>
                  <% elsif ad.subscription_status == 'canceling' %>
                    <span style="font-size: 11.5px; color: #92400E; font-weight: 500; display: inline-flex; align-items: center; gap: 4px;">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                      Résiliation programmée (fin de période)
                    </span>
                  <% end %>
                </div>
              </div>

              <!-- Real-time Stats & Actions -->
              <div class="sa-camp-card__stats">
                <div class="sa-camp-stat">
                  <span class="sa-camp-stat__number"><%= number_with_delimiter(ad.impressions_count.to_i, delimiter: " ") %></span>
                  <span class="sa-camp-stat__label">Impressions</span>
                </div>
                <div class="sa-camp-stat">
                  <span class="sa-camp-stat__number"><%= number_with_delimiter(ad.clicks_count.to_i, delimiter: " ") %></span>
                  <span class="sa-camp-stat__label">Clics</span>
                </div>
                <div class="sa-camp-stat">
                  <span class="sa-camp-stat__number"><%= ctr %> %</span>
                  <span class="sa-camp-stat__label">CTR</span>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="sa-dash__empty">
          <div class="sa-dash__empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="sa-dash__empty-title">Aucune campagne pour le moment</h3>
          <p class="sa-dash__empty-text">
            Mettez en avant vos formations, vos JPO ou vos concours auprès de plus de 1 000 étudiants en Arts Appliqués et Design dès aujourd'hui.
          </p>
          <a href="<%= sa_funnel_path %>" class="sa-dash__btn-cta">
            Lancer ma première campagne →
          </a>
        </div>
      <% end %>
    </div>
  </main>
</div>

<!-- ========================================================================= -->
<!-- MODALE DE CONTACT / DEMANDE DE MODIFICATION DIRECTE -->
<!-- ========================================================================= -->
<div id="sa-support-modal" class="sa-modal-backdrop" style="display: none;">
  <div class="sa-modal-box">
    <div class="sa-modal-head">
      <div>
        <h3 class="sa-modal-title" id="sa-modal-head-title">Contacter l'équipe Omniscient Design</h3>
        <p class="sa-modal-subtitle">Une question, un besoin particulier ou une mise à jour de visuel ? Nous vous répondons sous 24h.</p>
      </div>
      <button type="button" class="sa-modal-close" onclick="closeSupportModal()">✕</button>
    </div>

    <%= form_with url: schools_ads_contact_path, method: :post, local: true, class: "sa-modal-form" do |f| %>
      <div class="sa-modal-field">
        <label class="sa-modal-label">Établissement / Entreprise</label>
        <%= f.text_field :school_name, value: @user&.etablissement&.name.presence || @user&.firstname.presence || "Mon Établissement", class: "sa-modal-input", required: true %>
      </div>

      <div class="sa-modal-field">
        <label class="sa-modal-label">Votre Email</label>
        <%= f.email_field :email, value: @user&.email, class: "sa-modal-input", required: true %>
      </div>

      <div class="sa-modal-field">
        <label class="sa-modal-label" id="sa-modal-msg-label">Votre message / Modifications souhaitées*</label>
        <%= f.text_area :message, id: "sa-modal-textarea", rows: 4, placeholder: "Ex: Je souhaite mettre à jour le lien de redirection ou remplacer le visuel de ma campagne...", class: "sa-modal-textarea", required: true %>
      </div>

      <div class="sa-modal-actions">
        <button type="button" class="sa-modal-btn-cancel" onclick="closeSupportModal()">Annuler</button>
        <%= f.submit "Envoyer ma demande →", class: "sa-modal-btn-submit" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  function openModificationModal(adTitle, adId) {
    document.getElementById('sa-modal-head-title').textContent = "Demande de modification d'annonce";
    document.getElementById('sa-modal-textarea').value = "[Demande de modification pour l'annonce #" + adId + " : " + adTitle + "]\n\nBonjour, je souhaite modifier les éléments suivants pour cette campagne : ";
    document.getElementById('sa-support-modal').style.display = 'flex';
    document.getElementById('sa-modal-textarea').focus();
  }

  function closeSupportModal() {
    document.getElementById('sa-support-modal').style.display = 'none';
  }

  // Fermer la modale si clic en dehors
  window.addEventListener('click', function(e) {
    var modal = document.getElementById('sa-support-modal');
    if (e.target === modal) {
      closeSupportModal();
    }
  });
</script>
