<div class="popup" 
     data-back-to-school-target="modal" 
     data-action="click->back-to-school#backgroundClick" 
     style="display: none; z-index: 9999;">
  <div class="popup-content bts-popup-card">
    <div class="top-popup">
      <svg class="close-popup" 
           data-action="click->back-to-school#closeModal" 
           style="cursor: pointer;"
           width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M19.9941 16.9964L33.3719 3.63981C33.7717 3.23995 33.9964 2.69763 33.9964 2.13215C33.9964 1.56667 33.7717 1.02435 33.3719 0.624492C32.972 0.224637 32.4297 0 31.8642 0C31.2987 0 30.7564 0.224637 30.3566 0.624492L17 14.0023L3.64343 0.624492C3.24358 0.224637 2.70125 5.02059e-07 2.13577 5.06273e-07C1.57029 5.10486e-07 1.02797 0.224637 0.628116 0.624492C0.228261 1.02435 0.00362441 1.56667 0.00362441 2.13215C0.0036244 2.69763 0.228261 3.23995 0.628116 3.63981L14.0059 16.9964L0.628116 30.3529C0.429087 30.5504 0.271115 30.7852 0.163309 31.044C0.055504 31.3027 0 31.5803 0 31.8606C0 32.1409 0.055504 32.4185 0.163309 32.6772C0.271115 32.936 0.429087 33.1709 0.628116 33.3683C0.825519 33.5673 1.06038 33.7253 1.31914 33.8331C1.5779 33.9409 1.85545 33.9964 2.13577 33.9964C2.4161 33.9964 2.69364 33.9409 2.95241 33.8331C3.21117 33.7253 3.44603 33.5673 3.64343 33.3683L17 19.9905L30.3566 33.3683C30.554 33.5673 30.7888 33.7253 31.0476 33.8331C31.3064 33.9409 31.5839 33.9964 31.8642 33.9964C32.1445 33.9964 32.4221 33.9409 32.6809 33.8331C32.9396 33.7253 33.1745 33.5673 33.3719 33.3683C33.5709 33.1709 33.7289 32.936 33.8367 32.6772C33.9445 32.4185 34 32.1409 34 31.8606C34 31.5803 33.9445 31.3027 33.8367 31.044C33.7289 30.7852 33.5709 30.5504 33.3719 30.3529L19.9941 16.9964Z" fill="#202020"/>
      </svg>
    </div>

    <div class="popup-inner">
      <div class="bts-modal-header">
        <h2 class="title-popup"><%= t('back_to_school.modal_title', default: "Bonne rentrée ! 🎓") %></h2>
        <p class="subtitle"><%= t('back_to_school.modal_desc', default: "Pour cette nouvelle année scolaire, actualise ton niveau d'études afin de recevoir des recommandations et contenus personnalisés.") %></p>
      </div>

      <%= form_with(url: update_study_level_users_path, method: :patch, local: true, data: { turbo: false }) do |f| %>
        <div class="field">
          <label style="margin-bottom: 8px; display: block; font-weight: 500;">
            <%= t('back_to_school.select_label', default: "Ton niveau pour cette année :") %>
          </label>
          <%= f.select "user[study_level]", 
                       options_for_select(User::STUDY_LEVELS, current_user.study_level), 
                       { prompt: t('back_to_school.select_prompt', default: "Rechercher un niveau scolaire...") }, 
                       { 
                         required: true, 
                         class: "form-control",
                         data: { 
                           controller: "select2",
                           select2_placeholder_value: "Rechercher un niveau scolaire..."
                         }
                       } %>
        </div>

        <div class="field">
          <label style="margin-bottom: 8px; display: block; font-weight: 500;">
            <%= t('back_to_school.establishment_label', default: "Ton établissement scolaire :") %>
          </label>
          <%= f.collection_select "user[etablissement_id]", 
                                  Etablissement.order(:city), 
                                  :id, 
                                  :all_info, 
                                  { 
                                    include_blank: t('back_to_school.no_establishment_option', default: "Aucun établissement / Établissement manquant"),
                                    selected: current_user.etablissement_id 
                                  }, 
                                  { 
                                    class: "form-control",
                                    data: { 
                                      controller: "select2",
                                      select2_placeholder_value: t('back_to_school.establishment_placeholder', default: "Rechercher ou laisser vide...")
                                    }
                                  } %>
          <small style="margin-top: 6px; display: block; font-size: 0.8rem; color: #888888;">
            <%= t('back_to_school.establishment_help', default: "Optionnel. Si ton établissement ne figure pas dans la liste ou si tu souhaites le retirer, sélectionne « Aucun établissement ».") %>
          </small>
        </div>

        <div class="bts-modal-footer">
          <%= f.submit t('back_to_school.submit_button', default: "Valider mes informations"), class: "button large dark" %>
          
          <% if current_user.study_level.present? %>
            <%= button_tag type: :submit, 
                           name: "no_change", 
                           value: "true", 
                           class: "button bts-btn-same-level",
                           formnovalidate: true do %>
              <%= t('back_to_school.no_change_button', level: current_user.study_level, default: "Mon niveau n'a pas changé (%{level})") %>
            <% end %>
          <% end %>

          <a href="#" class="underline" data-action="click->back-to-school#closeModal">
            <%= t('back_to_school.later_button', default: "Plus tard") %>
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>
