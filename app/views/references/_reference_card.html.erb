<%= link_to reference do %>
  <%
    thumb_url = nil
    if reference.reference_images.first&.file&.attached?
      begin
        thumb_url = url_for(reference.reference_images.first.file.variant(:thumb))
      rescue StandardError => e
        thumb_url = nil
      end
    end
  %>
  <% if thumb_url.present? %>
    <div class="card-reference" style="background: url('<%= thumb_url %>'); background-size: cover; background-position: center center;">
  <% else %>
    <div class="card-reference" style="background: #F3F3F3;">
  <% end %>
      <div class="inner-card-reference">
        <p class="domaine-card-reference"><%= reference.domaines.map(&:domaine).join(', ') %></p>
        <p class="title-card-reference"><%= reference.nom_reference %></p>
      </div>
    </div>
  <% end %>

  